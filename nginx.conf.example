# =====================================================
# نمونه تنظیمات Nginx برای سایت FarhidWood
# =====================================================
#
# این فایل رو کپی کن به:
#   /etc/nginx/sites-available/farhidwood
# بعد فعالش کن:
#   sudo ln -s /etc/nginx/sites-available/farhidwood /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl reload nginx
#
# قبل از استفاده، این‌ها رو با مقادیر واقعی خودت جایگزین کن:
#   yourdomain.com          -> دامنه‌ی واقعی‌ات
#   /var/www/farhidwood/dist -> مسیر خروجی build فرانت‌اند روی سرور
#                                (خروجی دستور: npm run build)
#
# بعد از این مرحله، certbot (Let's Encrypt) رو اجرا کن تا
# خودش این فایل رو برای HTTPS آپدیت کنه:
#   sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # فایل‌های ساخته‌شده‌ی فرانت‌اند (خروجی npm run build)
    root /var/www/farhidwood/dist;
    index index.html;

    # درخواست‌های صفحات React (client-side routing)
    location / {
        try_files $uri /index.html;
    }

    # درخواست‌های API به بک‌اند Node.js (پورت 5000) هدایت می‌شود
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # فایل‌های آپلودشده (عکس/ویدیوی پروژه‌ها) هم از همان بک‌اند سرو می‌شود
    location /uploads/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
    }
}
