PORT=

MONGO_URI=

CLIENT_URL=

NODE_ENV=
SHOW_OTP_IN_CONSOLE=

JWT_SECRET=

JWT_EXPIRES_IN=

SMS_API_KEY=

SMS_TEMPLATE_ID=

SMS_LINE_NUMBER=

EITAA_BOT_TOKEN=
EITAA_CHAT_ID=

# مثال مقادیر (این‌ها را با مقادیر واقعی جایگزین کنید):
# PORT=5000
# MONGO_URI=mongodb://localhost:27017/farhidwood   <-- اگر Mongo را خودت روی سرور نصب کنی
# CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com
# NODE_ENV=production
# SHOW_OTP_IN_CONSOLE=false   <-- در production همیشه false باشد
# JWT_SECRET=یک-رشته-تصادفی-طولانی-و-امن (با node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" بساز)
# JWT_EXPIRES_IN=12h
# EITAA_BOT_TOKEN=توکن-برنامه-ساخته‌شده-در-eitaayar.ir
# EITAA_CHAT_ID=عدد-چت-آیدی-خودت-از-eitaayar.ir

# نکته درباره‌ی ادمین‌ها:
# دیگر شماره ادمین توی .env نیست. برای اضافه/غیرفعال‌کردن ادمین از این دستور استفاده کن:
#   npm run admin add 09xxxxxxxxx
#   npm run admin list
#   npm run admin deactivate 09xxxxxxxxx
